      "template": "templates/tool.php",
      "content": "<!-- wp:group {\"className\":\"tool-hero\"} --><div class=\"wp-block-group tool-hero\"><!-- wp:group {\"className\":\"tool-copy\"} --><div class=\"wp-block-group tool-copy\"><!-- wp:image {\"id\":{{attachment:winaudioclean-icon}},\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"tool-icon\"} --><figure class=\"wp-block-image size-full tool-icon\"><img src=\"{{asset:winaudioclean-icon}}\" alt=\"\" class=\"wp-image-{{attachment:winaudioclean-icon}}\"/></figure><!-- /wp:image -->\n<!-- wp:paragraph {\"className\":\"tagline\"} --><p class=\"tagline\">Give spoken audio a cleaner finish.</p><!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"description\"} --><p class=\"description\">Clean and level speech recordings locally with PowerShell and FFmpeg. Use Raw for cleaning and leveling, or Zoom/Teams for leveling only.</p><!-- /wp:paragraph -->\n<!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://github.com/PikkuJanne/WinAudioClean/releases/tag/v1.0.0\">Download v1.0.0</a></div><!-- /wp:button -->\n<!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://github.com/PikkuJanne/WinAudioClean/blob/v1.0.0/README.md\">Source &amp; instructions</a></div><!-- /wp:button -->\n</div><!-- /wp:buttons -->\n</div><!-- /wp:group -->\n<!-- wp:image {\"id\":{{attachment:winaudioclean-character}},\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"tool-art\"} --><figure class=\"wp-block-image size-full tool-art\"><img src=\"{{asset:winaudioclean-character}}\" alt=\"\" class=\"wp-image-{{attachment:winaudioclean-character}}\"/></figure><!-- /wp:image -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-benefits\"} --><div class=\"wp-block-group tool-section tool-benefits\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">What it does</h2><!-- /wp:heading -->\n<!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Choose processing suited to the recording.</li><!-- /wp:list-item -->\n<!-- wp:list-item --><li>Compare short previews before full processing.</li><!-- /wp:list-item -->\n<!-- wp:list-item --><li>Export WAV audio with local processing reports.</li><!-- /wp:list-item -->\n</ul><!-- /wp:list -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-requirements\"} --><div class=\"wp-block-group tool-section tool-requirements\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Requirements</h2><!-- /wp:heading -->\n<!-- wp:paragraph --><p>Windows desktop; Windows PowerShell 5.1 or PowerShell 7; separately supplied FFmpeg and FFprobe. Windows 10/11 are intended targets, with recorded Windows 11 checks rather than universal compatibility certification. Keep all package components together.</p><!-- /wp:paragraph -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-start\"} --><div class=\"wp-block-group tool-section tool-start\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Get started</h2><!-- /wp:heading -->\n<!-- wp:paragraph --><p>Extract the full tool-only ZIP, supply dependencies, and drag a simply named recording onto <code>WinAudioClean.bat</code>. Choose Raw or Zoom/Teams.</p><!-- /wp:paragraph -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-limits\"} --><div class=\"wp-block-group tool-section tool-limits\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Output & limits</h2><!-- /wp:heading -->\n<!-- wp:paragraph --><p>Default export is 48 kHz, 16-bit PCM WAV. Requested targets are −12 LUFS and −1.5 dBTP, not RMS. Accurate measurement is optional; default Fast mode does not measure final compliance. Listen to exports. Gentle is experimental and should not be promoted as an approved default.</p><!-- /wp:paragraph -->\n</div><!-- /wp:group -->\n<!-- wp:paragraph {\"className\":\"tool-return\"} --><p class=\"tool-return\"><a href=\"{{page:home}}#tools\">&larr; Back to all tools</a></p><!-- /wp:paragraph -->\n",
      "social_slot": "winaudioclean-social"
