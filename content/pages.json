    {
      "id": "winbooksplit",
      "slug": "winbooksplit",
      "title": "WinBookSplit",
      "excerpt": "Split PDFs into organized chapter files using bookmarks or manual page selections. Convert EPUB and AZW3 books through Calibre before splitting.",
      "template": "templates/tool.php",
      "content": "<!-- wp:group {\"className\":\"tool-hero\"} --><div class=\"wp-block-group tool-hero\"><!-- wp:group {\"className\":\"tool-copy\"} --><div class=\"wp-block-group tool-copy\"><!-- wp:image {\"id\":{{attachment:winbooksplit-icon}},\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"tool-icon\"} --><figure class=\"wp-block-image size-full tool-icon\"><img src=\"{{asset:winbooksplit-icon}}\" alt=\"\" class=\"wp-image-{{attachment:winbooksplit-icon}}\"/></figure><!-- /wp:image -->\n<!-- wp:paragraph {\"className\":\"tagline\"} --><p class=\"tagline\">Turn a large book into focused chapters.</p><!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"description\"} --><p class=\"description\">Split PDFs into organized chapter files using bookmarks or manual page selections. Convert EPUB and AZW3 books through Calibre before splitting.</p><!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"release-pending\"} --><p class=\"release-pending\">Release link pending</p><!-- /wp:paragraph -->\n<!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://github.com/PikkuJanne/WinBookSplit/blob/main/README.md\">Source &amp; instructions</a></div><!-- /wp:button -->\n</div><!-- /wp:buttons -->\n</div><!-- /wp:group -->\n<!-- wp:image {\"id\":{{attachment:winbooksplit-character}},\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"tool-art\"} --><figure class=\"wp-block-image size-full tool-art\"><img src=\"{{asset:winbooksplit-character}}\" alt=\"\" class=\"wp-image-{{attachment:winbooksplit-character}}\"/></figure><!-- /wp:image -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-benefits\"} --><div class=\"wp-block-group tool-section tool-benefits\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">What it does</h2><!-- /wp:heading -->\n<!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Split by main chapters or subsections.</li><!-- /wp:list-item -->\n<!-- wp:list-item --><li>Use manual selections when bookmarks are unavailable.</li><!-- /wp:list-item -->\n<!-- wp:list-item --><li>Keep chapter files ordered with readable names.</li><!-- /wp:list-item -->\n</ul><!-- /wp:list -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-requirements\"} --><div class=\"wp-block-group tool-section tool-requirements\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Requirements</h2><!-- /wp:heading -->\n<!-- wp:paragraph --><p>Windows 11 x64; Windows PowerShell 5.1 or tested PowerShell 7.6.5; x64 CPython 3.14.8 with pypdf 6.19.0 using the documented pinned setup. EPUB/AZW3 conversion requires Calibre 9.15.0. Windows 10 is unverified.</p><!-- /wp:paragraph -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-start\"} --><div class=\"wp-block-group tool-section tool-start\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Get started</h2><!-- /wp:heading -->\n<!-- wp:paragraph --><p>Keep the full tool package together and follow the pinned dependency setup on GitHub. Drop one PDF, EPUB or AZW3 file onto <code>WinBookSplit.bat</code>, choose a bookmark level or manual mode, then review and confirm the chapter plan.</p><!-- /wp:paragraph -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-limits\"} --><div class=\"wp-block-group tool-section tool-limits\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Output & limits</h2><!-- /wp:heading -->\n<!-- wp:paragraph --><p>A fresh chapter-PDF folder preserves the source; local diagnostics record the run. Encrypted PDFs, interactive forms, signatures and detected active or embedded-document features are rejected. Ebook conversion can change layout and bookmarks. Manual splits use physical PDF page numbers. No OCR is documented.</p><!-- /wp:paragraph -->\n</div><!-- /wp:group -->\n<!-- wp:paragraph {\"className\":\"tool-return\"} --><p class=\"tool-return\"><a href=\"{{page:home}}#tools\">&larr; Back to all tools</a></p><!-- /wp:paragraph -->\n",
      "social_slot": "winbooksplit-social"
    },
    {
      "id": "winpdfmerger",
      "slug": "winpdfmerger",
      "title": "WinPDFMerger",
      "excerpt": "Merge a folder of PDFs into one master document, with an optional smaller email copy. Keep source documents and existing outputs intact.",
      "template": "templates/tool.php",
      "content": "<!-- wp:group {\"className\":\"tool-hero\"} --><div class=\"wp-block-group tool-hero\"><!-- wp:group {\"className\":\"tool-copy\"} --><div class=\"wp-block-group tool-copy\"><!-- wp:image {\"id\":{{attachment:winpdfmerger-icon}},\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"tool-icon\"} --><figure class=\"wp-block-image size-full tool-icon\"><img src=\"{{asset:winpdfmerger-icon}}\" alt=\"\" class=\"wp-image-{{attachment:winpdfmerger-icon}}\"/></figure><!-- /wp:image -->\n<!-- wp:paragraph {\"className\":\"tagline\"} --><p class=\"tagline\">Bring your PDFs together.</p><!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"description\"} --><p class=\"description\">Merge a folder of PDFs into one master document, with an optional smaller email copy. Keep source documents and existing outputs intact.</p><!-- /wp:paragraph -->\n<!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://github.com/PikkuJanne/WinPDFMerger/releases/tag/v1.0.0\">Download v1.0.0</a></div><!-- /wp:button -->\n<!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://github.com/PikkuJanne/WinPDFMerger/blob/v1.0.0/README.md\">Source &amp; instructions</a></div><!-- /wp:button -->\n</div><!-- /wp:buttons -->\n</div><!-- /wp:group -->\n<!-- wp:image {\"id\":{{attachment:winpdfmerger-character}},\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"tool-art\"} --><figure class=\"wp-block-image size-full tool-art\"><img src=\"{{asset:winpdfmerger-character}}\" alt=\"\" class=\"wp-image-{{attachment:winpdfmerger-character}}\"/></figure><!-- /wp:image -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-benefits\"} --><div class=\"wp-block-group tool-section tool-benefits\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">What it does</h2><!-- /wp:heading -->\n<!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Merge top-level PDFs in natural filename order.</li><!-- /wp:list-item -->\n<!-- wp:list-item --><li>Create an optional email copy with Ghostscript.</li><!-- /wp:list-item -->\n<!-- wp:list-item --><li>Keep a local log of the merge.</li><!-- /wp:list-item -->\n</ul><!-- /wp:list -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-requirements\"} --><div class=\"wp-block-group tool-section tool-requirements\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Requirements</h2><!-- /wp:heading -->\n<!-- wp:paragraph --><p>Windows 11 x64; Windows PowerShell 5.1 for the BAT launcher. Direct PowerShell 7.6.6 x64 invocation is documented as tested. PDFtk Server is required; Ghostscript is optional. Windows 10, ARM and live UNC shares remain unvalidated.</p><!-- /wp:paragraph -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-start\"} --><div class=\"wp-block-group tool-section tool-start\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Get started</h2><!-- /wp:heading -->\n<!-- wp:paragraph --><p>Extract the complete v1.0.0 ZIP, keeping <code>VERSION</code> and <code>src/WinPDFMerge.Helpers.ps1</code> with the launchers. Install PDFtk, then drop exactly one source folder onto <code>WinPDFMerge.bat</code>. Default output is beside the scripts; use PowerShell named options for a separate existing output folder.</p><!-- /wp:paragraph -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-limits\"} --><div class=\"wp-block-group tool-section tool-limits\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Output & limits</h2><!-- /wp:heading -->\n<!-- wp:paragraph --><p>A validated master PDF, an optional smaller <code>_email.pdf</code>, and a local log. Only visible top-level PDFs are scanned. Sources and existing outputs remain intact. Email rewriting can lose detail or features; neither output guarantees valid signatures or universal PDF feature retention.</p><!-- /wp:paragraph -->\n</div><!-- /wp:group -->\n<!-- wp:paragraph {\"className\":\"tool-return\"} --><p class=\"tool-return\"><a href=\"{{page:home}}#tools\">&larr; Back to all tools</a></p><!-- /wp:paragraph -->\n",
      "social_slot": "winpdfmerger-social"
    },
    {
      "id": "winvidcompress",
      "slug": "winvidcompress",
      "title": "WinVidCompress",
      "excerpt": "Create H.264/AAC MP4 viewing copies of videos with a focused PowerShell and FFmpeg workflow. Process individual files or folders locally.",
      "template": "templates/tool.php",
      "content": "<!-- wp:group {\"className\":\"tool-hero\"} --><div class=\"wp-block-group tool-hero\"><!-- wp:group {\"className\":\"tool-copy\"} --><div class=\"wp-block-group tool-copy\"><!-- wp:image {\"id\":{{attachment:winvidcompress-icon}},\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"tool-icon\"} --><figure class=\"wp-block-image size-full tool-icon\"><img src=\"{{asset:winvidcompress-icon}}\" alt=\"\" class=\"wp-image-{{attachment:winvidcompress-icon}}\"/></figure><!-- /wp:image -->\n<!-- wp:paragraph {\"className\":\"tagline\"} --><p class=\"tagline\">Make a viewing copy. Keep the original.</p><!-- /wp:paragraph -->\n<!-- wp:paragraph {\"className\":\"description\"} --><p class=\"description\">Create H.264/AAC MP4 viewing copies of videos with a focused PowerShell and FFmpeg workflow. Process individual files or folders locally.</p><!-- /wp:paragraph -->\n<!-- wp:buttons --><div class=\"wp-block-buttons\"><!-- wp:button --><div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://github.com/PikkuJanne/WinVidCompress/releases/tag/v1.0.0\">Download v1.0.0</a></div><!-- /wp:button -->\n<!-- wp:button {\"className\":\"is-style-outline\"} --><div class=\"wp-block-button is-style-outline\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://github.com/PikkuJanne/WinVidCompress/blob/v1.0.0/README.md\">Source &amp; instructions</a></div><!-- /wp:button -->\n</div><!-- /wp:buttons -->\n</div><!-- /wp:group -->\n<!-- wp:image {\"id\":{{attachment:winvidcompress-character}},\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"className\":\"tool-art\"} --><figure class=\"wp-block-image size-full tool-art\"><img src=\"{{asset:winvidcompress-character}}\" alt=\"\" class=\"wp-image-{{attachment:winvidcompress-character}}\"/></figure><!-- /wp:image -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-benefits\"} --><div class=\"wp-block-group tool-section tool-benefits\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">What it does</h2><!-- /wp:heading -->\n<!-- wp:list --><ul class=\"wp-block-list\"><!-- wp:list-item --><li>Queue files and folders through drag and drop.</li><!-- /wp:list-item -->\n<!-- wp:list-item --><li>Apply a consistent CRF 22 video profile.</li><!-- /wp:list-item -->\n<!-- wp:list-item --><li>Preserve originals and avoid overwriting existing copies.</li><!-- /wp:list-item -->\n</ul><!-- /wp:list -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-requirements\"} --><div class=\"wp-block-group tool-section tool-requirements\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Requirements</h2><!-- /wp:heading -->\n<!-- wp:paragraph --><p>Windows 11; Windows PowerShell 5.1 or supported stable PowerShell 7; separately supplied FFmpeg and FFprobe with required encoding capabilities. PATH takes precedence over adjacent executables.</p><!-- /wp:paragraph -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-start\"} --><div class=\"wp-block-group tool-section tool-start\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Get started</h2><!-- /wp:heading -->\n<!-- wp:paragraph --><p>Extract the release, supply FFmpeg/FFprobe, then open <code>WinVidCompress.bat</code> or drop videos/folders onto it. Use <code>-CheckEnvironment</code> for setup diagnostics.</p><!-- /wp:paragraph -->\n</div><!-- /wp:group -->\n<!-- wp:group {\"className\":\"tool-section tool-limits\"} --><div class=\"wp-block-group tool-section tool-limits\"><!-- wp:heading {\"level\":2} --><h2 class=\"wp-block-heading\">Output & limits</h2><!-- /wp:heading -->\n<!-- wp:paragraph --><p>MP4 with libx264 veryfast, CRF 22, AAC 160 kbps and faststart. Oriented height is capped at 1080 without upscale; width is not capped at 1920. Output is lossy SDR; detected HDR is refused. Extra tracks/subtitles are omitted, and output can be larger than input.</p><!-- /wp:paragraph -->\n</div><!-- /wp:group -->\n<!-- wp:paragraph {\"className\":\"tool-return\"} --><p class=\"tool-return\"><a href=\"{{page:home}}#tools\">&larr; Back to all tools</a></p><!-- /wp:paragraph -->\n",
      "social_slot": "winvidcompress-social"
    },
